GIT_FTP_URL=ftp://example.com
GIT_FTP_USER=ftp_user
GIT_FTP_PASSWORD=replace_with_real_password

# Path on server where files should be uploaded.
GIT_FTP_REMOTE_ROOT=/public_html

# Local path relative to repository root.
GIT_FTP_SYNCROOT=.

# Set to 1 to skip frontend build before deploy.
GIT_FTP_SKIP_BUILD=0
GIT_FTP_BUILD_CMD="npm ci && npm run build"

# Set to 1 only for first upload when remote has no git-ftp state.
GIT_FTP_INIT=0

# Set to 1 for insecure FTP/TLS endpoints (not recommended).
GIT_FTP_INSECURE=0
